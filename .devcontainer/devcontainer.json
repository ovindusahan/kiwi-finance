{
  "name": "Kiwi Finance",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/java:1": { "version": "21", "jdkDistro": "tem" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "forwardPorts": [3000, 8080, 5432],
  "portsAttributes": {
    "3000": { "label": "Kiwi Finance", "onAutoForward": "openBrowser" },
    "8080": { "label": "Kiwi Finance API", "onAutoForward": "silent" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/start.sh build",
  "postStartCommand": "bash .devcontainer/start.sh up",
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
